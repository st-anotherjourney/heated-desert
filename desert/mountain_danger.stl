stop_music(2);
wait(2);
play_music(\"levels/desert/music/tuxvictorious.music\");
Tux.do_scripting_controller(\"down\", true);
wait(0.05);
Tux.do_scripting_controller(\"jump\", true);
wait(1);
Tux.do_scripting_controller(\"down\", false);
Tux.do_scripting_controller(\"jump\", false);
wait(2);
Effect.fade_out(2);
wait(8);
Level.finish(true);")
