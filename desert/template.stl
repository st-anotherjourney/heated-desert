(supertux-level
  (version 3)
  (name (_ "Desert Template"))
  (author "Vaesea")
  (license "CC-BY-SA 4.0 International")
  (allow-item-pocket "inherit")
  (icon "")
  (icon-locked "")
  (statistics
    (enable-coins #t)
    (enable-secrets #t)
  )
  (sector
    (name "main")
    (ambient-light
      (color 1 1 1)
    )
    (camera
      (name "Camera")
      (mode "normal")
    )
    (gradient
      (top_color 0.6 0.7 1)
      (bottom_color 1 1 1)
      (z-pos -400)
    )
    (gradient
      (top_color 1 0.8 0.2 0.2)
      (bottom_color 1 1 1 0)
      (z-pos 300)
    )
    (music
      (name "Music_Object")
      (file "/music/antarctic/midday.music")
    )
    (snail
      (z-pos 50)
      (sprite "/levels/desert/images/creatures/desertsnail/desertsnail.sprite")
      (x 128)
      (y 384)
      (glinting #f)
    )
    (snowball
      (type "bumpkin")
      (z-pos 50)
      (sprite "/levels/desert/images/creatures/sandmonster/sandmonster.sprite")
      (x 240)
      (y 400)
      (glinting #f)
    )
    (spawnpoint
      (name "main")
      (x 64)
      (y 480)
    )
    (tilemap
      (solid #f)
      (z-pos -100)
      (name "MidGround_Tiles")
      (width 350)
      (height 60)
      (tiles -21000 0)
    )
    (tilemap
      (solid #f)
      (z-pos -150)
      (name "BackGround_Tiles")
      (width 350)
      (height 60)
      (tiles -21000 0)
    )
    (tilemap
      (solid #t)
      (tint 1 0.8 0.5)
      (z-pos 0)
      (name "Main_Tiles")
      (width 350)
      (height 60)
      (tiles -21000 0)
    )
    (tilemap
      (solid #t)
      (z-pos 1)
      (width 350)
      (height 60)
      (tiles -21000 0)
    )
  )
)
